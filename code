    def apply_chroma_key(self, img, sensitivity=45):
        img = img.convert("RGBA")
        datas = img.getdata()
        new_data = []
        for item in datas:
            r, g, b, a = item
            if g > r + sensitivity and g > b + sensitivity and g > 50:
                new_data.append((r, g, b, 0))
            else:
                new_data.append(item)
        img.putdata(new_data)
        return img

    def generate_composite(self):
        # 1. Base Image Canvas
        if not self.bg_path.get():
            bg = Image.new("RGBA", (1920, 1080), (10, 14, 26, 255))
            draw_bg = ImageDraw.Draw(bg)
            for x in range(0, 1920, 120):
                draw_bg.line([(x, 0), (x, 1080)], fill=(20, 28, 48, 255), width=1)
            for y in range(0, 1080, 100):
                draw_bg.line([(0, y), (1920, y)], fill=(20, 28, 48, 255), width=1)
        else:
            try:
                bg = Image.open(self.bg_path.get()).convert("RGBA")
            except Exception as e:
                messagebox.showerror("Error", f"Failed to load background:\n{e}")
                return None

        bg_w, bg_h = bg.size
        scale_factor = bg_h / 1080.0
        draw = ImageDraw.Draw(bg)

        # ==========================================
        # 2. Bullish Growth Compounding Curve
        # ==========================================
        if self.draw_bull_arrow.get():
            curve_points = []
            start_x = int(100 * scale_factor)
            end_x = int(bg_w * 0.75)
            base_curve_y = int(bg_h * 0.90)
            peak_y = int(bg_h * 0.38)
            
            steps = 40
            for i in range(steps + 1):
                t = i / steps
                cx = start_x + t * (end_x - start_x)
                cy = base_curve_y - (base_curve_y - peak_y) * (math.pow(t, 2.4))
                curve_points.append((int(cx), int(cy)))

            thick_w = int(12 * scale_factor)
            draw.line(curve_points, fill=(0, 230, 118, 160), width=thick_w + int(8 * scale_factor))
            draw.line(curve_points, fill="#00E676", width=thick_w)

            ax, ay = curve_points[-1]
            arrow_size = int(32 * scale_factor)
            draw.polygon([
                (ax, ay - int(arrow_size * 0.6)),
                (ax + int(arrow_size * 0.8), ay + int(arrow_size * 0.5)),
                (ax - int(arrow_size * 0.4), ay + int(arrow_size * 0.3))
            ], fill="#00E676")

        # ==========================================
        # 3. Creator Headshot
        # ==========================================
        if self.use_head.get() and self.head_path.get():
            try:
                raw_head = Image.open(self.head_path.get())
                orig_w, orig_h = raw_head.size
                target_h = int(self.head_scale_slider.get() * scale_factor)
                target_w = int(target_h * (orig_w / orig_h))

                resized_head = raw_head.resize((target_w, target_h), Image.Resampling.LANCZOS)
                keyed_head = self.apply_chroma_key(resized_head)

                if self.flip_head.get():
                    keyed_head = keyed_head.transpose(Image.Transpose.FLIP_LEFT_RIGHT)

                if self.head_align_left.get():
                    hx = int(40 * scale_factor)
                else:
                    hx = bg_w - target_w - int(20 * scale_factor)

                hy = bg_h - target_h
                bg.paste(keyed_head, (int(hx), int(hy)), keyed_head)
            except Exception:
                pass

        # ==========================================
        # 4. Top Series Badge ("INVESTING $1500 / MONTH...")
        # ==========================================
        if self.use_series_title.get():
            s_text = self.series_title_text.get().strip().upper()
            if s_text:
                s_font = self.get_font("Trebuchet MS Bold (Clean & Punchy)", int(42 * scale_factor))
                bbox = draw.textbbox((0, 0), s_text, font=s_font)
                tw = bbox[2] - bbox[0]
                th = bbox[3] - bbox[1]

                pad_x = int(32 * scale_factor)
                pad_y = int(14 * scale_factor)
                banner_y = int(self.series_y_slider.get() * scale_factor)
                banner_x = int(60 * scale_factor)

                pill_rect = (banner_x, banner_y, banner_x + tw + pad_x * 2, banner_y + th + pad_y * 2)
                draw.rounded_rectangle(
                    pill_rect, 
                    radius=int(14 * scale_factor), 
                    fill=self.series_banner_color, 
                    outline="#FFE600", 
                    width=int(3 * scale_factor)
                )

                tx = banner_x + pad_x - bbox[0]
                ty = banner_y + pad_y - bbox[1]
                draw.text((tx, ty), s_text, font=s_font, fill=self.series_title_color)

        # ==========================================
        # 5. Monthly Update Headline ("SEPTEMBER 2026 UPDATE")
        # ==========================================
        if self.use_update_title.get():
            u_text = self.update_title_text.get().strip().upper()
            if u_text:
                u_size = int(self.update_size_slider.get() * scale_factor)
                u_font = self.get_font(self.font_choice.get(), u_size)
                stroke_w = int(10 * scale_factor)
                shadow_d = int(8 * scale_factor)

                bbox = draw.textbbox((0, 0), u_text, font=u_font, stroke_width=stroke_w)
                tw = bbox[2] - bbox[0]
                th = bbox[3] - bbox[1]

                ux = int(60 * scale_factor) - bbox[0]
                uy = int(self.update_y_slider.get() * scale_factor) - bbox[1]

                # Drop Shadow
                draw.text((ux + shadow_d, uy + shadow_d), u_text, font=u_font, fill="#000000", stroke_width=stroke_w, stroke_fill="#000000")
                # Main Headline
                draw.text((ux, uy), u_text, font=u_font, fill=self.update_title_color, stroke_width=stroke_w, stroke_fill=self.update_border_color)

        # ==========================================
        # 6. Timeline Tracker Badges (Neon Pink Theme)
        # ==========================================
        if self.use_tracker.get():
            y_str = self.year_text.get().strip().upper()
            m_str = self.month_text.get().strip().upper()

            t_font = self.get_font("Bahnschrift (DIN Tech/Numbers)", int(46 * scale_factor))
            t_base_y = int(self.tracker_y_slider.get() * scale_factor)
            cur_x = int(60 * scale_factor)

            # Year Badge - Neon Pink
            if y_str:
                y_box = draw.textbbox((0, 0), y_str, font=t_font)
                yw = y_box[2] - y_box[0]
                yh = y_box[3] - y_box[1]
                ypad = int(18 * scale_factor)
                
                rect_y = (cur_x, t_base_y, cur_x + yw + ypad * 2, t_base_y + yh + ypad * 2)
                draw.rounded_rectangle(
                    rect_y, 
                    radius=int(10 * scale_factor), 
                    fill=self.tracker_bg_color, 
                    outline=self.tracker_pink_color, 
                    width=int(3 * scale_factor)
                )
                draw.text((cur_x + ypad - y_box[0], t_base_y + ypad - y_box[1]), y_str, font=t_font, fill=self.tracker_pink_color)
                cur_x += yw + ypad * 2 + int(16 * scale_factor)

            # Month Badge - Neon Pink
            if m_str:
                m_box = draw.textbbox((0, 0), m_str, font=t_font)
                mw = m_box[2] - m_box[0]
                mh = m_box[3] - m_box[1]
                mpad = int(18 * scale_factor)

                rect_m = (cur_x, t_base_y, cur_x + mw + mpad * 2, t_base_y + mh + mpad * 2)
                draw.rounded_rectangle(
                    rect_m, 
                    radius=int(10 * scale_factor), 
                    fill=self.tracker_bg_color, 
                    outline=self.tracker_pink_color, 
                    width=int(3 * scale_factor)
                )
                draw.text((cur_x + mpad - m_box[0], t_base_y + mpad - m_box[1]), m_str, font=t_font, fill=self.tracker_pink_color)

        # ==========================================
        # 7. Portfolio Value & Amount Invested Card
        # ==========================================
        if self.use_metric_badge.get():
            theme_color = self.metric_red if self.is_loss_red.get() else self.metric_green

            inv_str = self.invested_text.get().strip().upper()
            m_label = self.metric_label.get().strip().upper()
            m_val = self.metric_value.get().strip().upper()

            inv_font = self.get_font("Bahnschrift (DIN Tech/Numbers)", int(36 * scale_factor))
            lbl_font = self.get_font("Trebuchet MS Bold (Clean & Punchy)", int(30 * scale_factor))
            val_font = self.get_font("Impact (Finance Classic)", int(58 * scale_factor))

            inv_box = draw.textbbox((0, 0), inv_str, font=inv_font)
            l_box = draw.textbbox((0, 0), m_label, font=lbl_font)
            v_box = draw.textbbox((0, 0), m_val, font=val_font)

            inv_w = (inv_box[2] - inv_box[0]) if inv_str else 0
            inv_h = (inv_box[3] - inv_box[1]) if inv_str else 0

            lbl_w = l_box[2] - l_box[0]
            lbl_h = l_box[3] - l_box[1]

            val_w = v_box[2] - v_box[0]
            val_h = v_box[3] - v_box[1]

            badge_w = max(inv_w, lbl_w, val_w) + int(48 * scale_factor)
            extra_h = (inv_h + int(12 * scale_factor)) if inv_str else 0
            badge_h = lbl_h + val_h + extra_h + int(48 * scale_factor)

            bx = int(60 * scale_factor)
            by = int(self.metric_y_slider.get() * scale_factor)

            # High-contrast investment card
            draw.rounded_rectangle(
                (bx, by, bx + badge_w, by + badge_h),
                radius=int(16 * scale_factor),
                fill=(12, 18, 32, 245),
                outline=theme_color,
                width=int(4 * scale_factor)
            )

            cur_card_y = by + int(16 * scale_factor)

            # 1. Amount Invested
            if inv_str:
                draw.text(
                    (bx + int(24 * scale_factor) - inv_box[0], cur_card_y - inv_box[1]),
                    inv_str, font=inv_font, fill="#FFFFFF"
                )
                cur_card_y += inv_h + int(10 * scale_factor)

            # 2. Portfolio Label
            draw.text(
                (bx + int(24 * scale_factor) - l_box[0], cur_card_y - l_box[1]),
                m_label, font=lbl_font, fill="#9CA3AF"
            )
            cur_card_y += lbl_h + int(4 * scale_factor)

            # 3. Portfolio Value / Return
            draw.text(
                (bx + int(24 * scale_factor) - v_box[0], cur_card_y - v_box[1]),
                m_val, font=val_font, fill=theme_color
            )

        return bg

    def update_preview(self):
        composite = self.generate_composite()
        if composite:
            self.current_composite = composite
            w, h = int(self.current_preview_w), int(self.current_preview_h)
            preview_img = composite.resize((w, h), Image.Resampling.LANCZOS)
            self.preview_image_tk = ImageTk.PhotoImage(preview_img)
            self.preview_canvas.delete("all")
            self.preview_canvas.create_image(w // 2, h // 2, anchor=tk.CENTER, image=self.preview_image_tk)

    def save_thumbnail(self):
        if not self.current_composite:
            self.update_preview()
            if not self.current_composite:
                messagebox.showwarning("Warning", "Nothing to save. Please load assets first.")
                return

        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        default_filename = f"investment_thumbnail_{timestamp}.png"

        file_path = filedialog.asksaveasfilename(
            defaultextension=".png",
            filetypes=[("PNG Image", "*.png"), ("JPEG Image", "*.jpg")],
            initialfile=default_filename,
        )
        if file_path:
            try:
                output_image = self.current_composite.convert("RGB")
                output_image.save(file_path, quality=95)
                self.last_saved_dir = os.path.dirname(file_path)
                messagebox.showinfo("Success", f"Thumbnail successfully saved to:\n{file_path}")
            except Exception as e:
                messagebox.showerror("Error", f"Failed to save image:\n{e}")

    def open_saved_folder(self):
        if self.last_saved_dir and os.path.exists(self.last_saved_dir):
            try:
                system_platform = platform.system()
                if system_platform == "Windows":
                    os.startfile(self.last_saved_dir)
                elif system_platform == "Darwin":
                    subprocess.Popen(["open", self.last_saved_dir])
                else:
                    subprocess.Popen(["xdg-open", self.last_saved_dir])
            except Exception as e:
                messagebox.showerror("Error", f"Could not open directory:\n{e}")
        else:
            messagebox.showwarning("Warning", "No save folder registered yet. Please save a thumbnail first.")


