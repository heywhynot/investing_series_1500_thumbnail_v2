    def pick_color(self, attr_name, btn_widget):
        current_val = getattr(self, attr_name)
        chosen = colorchooser.askcolor(color=current_val, title="Select Color")[1]
        if chosen:
            setattr(self, attr_name, chosen)
            btn_widget.config(bg=chosen)
            r, g, b = int(chosen[1:3], 16), int(chosen[3:5], 16), int(chosen[5:7], 16)
            btn_widget.config(fg="#000" if (r * 0.299 + g * 0.587 + b * 0.114) > 150 else "#FFF")
            self.update_preview()

    def get_font(self, font_name, size):
        candidates = FONT_MAP.get(font_name, ["impact.ttf", "arialbd.ttf", "arial.ttf"])
        for cand in candidates:
            try:
                return ImageFont.truetype(cand, int(size))
            except Exception:
                continue
        try:
            return ImageFont.truetype(font_name, int(size))
        except Exception:
            return ImageFont.load_default()

    def on_container_resize(self, event):
        if event.width < 100 or event.height < 100:
            return

        margin = 20
        avail_w = event.width - (margin * 2)
        avail_h = event.height - (margin * 2)

        target_ratio = 16.0 / 9.0
        current_ratio = avail_w / avail_h

        if current_ratio > target_ratio:
            new_h = avail_h
            new_w = int(avail_h * target_ratio)
        else:
            new_w = avail_w
            new_h = int(avail_w / target_ratio)

        if (self.current_preview_w != new_w) or (self.current_preview_h != new_h):
            self.current_preview_w = new_w
            self.current_preview_h = new_h
            self.preview_canvas.config(width=new_w, height=new_h)
            self.update_preview()

    def on_slider_move(self, val):
